{
  "$schema": "https://schemas.wp.org/wp/6.0/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1024px",
      "wideSize": "1275px"
    },
    "spacing": {
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "dropCap": false,
      "defaultFontSizes": false,
      "customFontSize": false,
      "fontFamilies": [
        {
          "name": "sans",
          "slug": "sans",
          "fontFamily": "ui-sans-serif, system-ui, sans-serif, Apple Color Emoji, Segoe UI Emoji, Segoe UI Symbol, Noto Color Emoji"
        },
        {
          "name": "serif",
          "slug": "serif",
          "fontFamily": "ui-serif, Georgia, Cambria, Times New Roman, Times, serif"
        },
        {
          "name": "mono",
          "slug": "mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace"
        }
      ],
      "fontSizes": [
        {
          "name": "xs",
          "slug": "xs",
          "size": ".75rem"
        },
        {
          "name": "sm",
          "slug": "sm",
          "size": ".875rem"
        },
        {
          "name": "base",
          "slug": "base",
          "size": "1rem"
        },
        {
          "name": "lg",
          "slug": "lg",
          "size": "1.125rem"
        },
        {
          "name": "xl",
          "slug": "xl",
          "size": "1.25rem"
        },
        {
          "name": "2xl",
          "slug": "2xl",
          "size": "1.5rem"
        },
        {
          "name": "3xl",
          "slug": "3xl",
          "size": "1.875rem"
        },
        {
          "name": "4xl",
          "slug": "4xl",
          "size": "2.25rem"
        },
        {
          "name": "5xl",
          "slug": "5xl",
          "size": "3rem"
        },
        {
          "name": "6xl",
          "slug": "6xl",
          "size": "3.75rem"
        },
        {
          "name": "7xl",
          "slug": "7xl",
          "size": "4.5rem"
        },
        {
          "name": "8xl",
          "slug": "8xl",
          "size": "6rem"
        },
        {
          "name": "9xl",
          "slug": "9xl",
          "size": "8rem"
        }
      ]
    },
    "border": {
      "radius": true,
      "radiusSizes": [
        {
          "name": "xs",
          "slug": "xs",
          "size": ".125rem"
        },
        {
          "name": "sm",
          "slug": "sm",
          "size": ".25rem"
        },
        {
          "name": "md",
          "slug": "md",
          "size": ".375rem"
        },
        {
          "name": "lg",
          "slug": "lg",
          "size": ".5rem"
        },
        {
          "name": "xl",
          "slug": "xl",
          "size": ".75rem"
        },
        {
          "name": "2xl",
          "slug": "2xl",
          "size": "1rem"
        },
        {
          "name": "3xl",
          "slug": "3xl",
          "size": "1.5rem"
        },
        {
          "name": "4xl",
          "slug": "4xl",
          "size": "2rem"
        }
      ]
    }
  }
}